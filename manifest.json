 "novedades": [
  {
   "fecha": "2026-11-26",
   "texto": "Leyes con sentido, cementerios en su sitio y guerras posibles"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Rasgos propios, necesidades en el ánimo y voto según cómo les va"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Mapas útiles: sin mapa no se navega ni se conocen pueblos lejanos; solo los cartógrafos lo amplían"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Partidas guardadas comprimidas: de ~80 MB a ~8,5 MB cada una"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Sed: nadie se queda quieto sin beber"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Murallas que siguen la orilla y cruzan los ríos con rejas; puertas en tramos verticales; esquinas; mancha de petróleo bajo los edificios"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Velocidad x3-x5: pasos adaptativos y sin parones al conectar calles en ciudades grandes"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Guerras solo entre naciones de cierto tamaño"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Ayuda alimentaria entre pueblos, casas que abrigan y sin muertes de sed en casa"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Misiles con control de armas, terrorismo, y supervivencia de las aldeas"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Barrios en las ciudades, sed y pozos, calendario de cada mundo nuevo"
  },
  {
   "fecha": "2026-11-26",
   "texto": "Agencias espaciales, fichas más ordenadas y ciudades que se expanden"
  }
 ],
