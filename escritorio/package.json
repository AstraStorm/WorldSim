{
  "name": "world-sim",
  "productName": "World Sim",
  "version": "1.0.0",
  "description": "World Sim: el juego y su launcher, con actualizaciones desde la nube",
  "main": "main.js",
  "author": "AstraStorm",
  "license": "UNLICENSED",
  "scripts": {
    "juego": "node copiar-juego.js",
    "start": "node copiar-juego.js && electron .",
    "dist": "node copiar-juego.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.astrastorm.forjademundos",
    "productName": "World Sim",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "juego-base",
        "to": "juego-base"
      }
    ],
    "win": {
      "icon": "launcher/icono.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "WorldSim-portable.exe"
    },
    "nsis": {
      "artifactName": "WorldSim-instalador.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "World Sim",
      "runAfterFinish": true,
      "installerIcon": "launcher/icono.ico",
      "uninstallerIcon": "launcher/icono.ico",
      "installerHeaderIcon": "launcher/icono.ico",
      "uninstallDisplayName": "World Sim",
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ]
    }
  }
}